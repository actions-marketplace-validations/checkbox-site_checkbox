{
  "name": "@checkbox-site/node",
  "version": "0.4.7",
  "description": "Checkbox Node.js SDK: auto-renewal law and subscription compliance checks (FTC ROSCA, California ARL, New York and other state laws) for Stripe Checkout compliance (Checkout Sessions, Payment Links) and other subscription checkouts, online cancellation flows and renewal reminder emails. Zero dependencies. Published to npm as @checkbox-site/node.",
  "keywords": [
    "subscription",
    "subscription-compliance",
    "auto-renewal",
    "auto-renewal-law",
    "automatic-renewal",
    "rosca",
    "click-to-cancel",
    "cancellation",
    "renewal-reminder",
    "renewal-reminder-emails",
    "stripe",
    "stripe-checkout",
    "compliance",
    "stripe-checkout-compliance",
    "stripe-compliance",
    "checkout-compliance",
    "auto-renewal-compliance",
    "subscription-law",
    "automatic-renewal-law",
    "ftc",
    "negative-option",
    "payment-links",
    "mcp",
    "auto-renewal-law-checker",
    "subscription compliance",
    "auto renewal",
    "autorenewal",
    "california-arl",
    "subscription-cancellation",
    "stripe-subscriptions",
    "checkout"
  ],
  "license": "MIT",
  "author": "Checkbox <support@checkbox.site>",
  "homepage": "https://checkbox.site/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkbox-site/checkbox.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/checkbox-site/checkbox/issues",
    "email": "support@checkbox.site"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  }
}
