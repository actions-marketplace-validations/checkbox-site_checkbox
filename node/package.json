{
  "name": "@checkbox-site/node",
  "version": "0.2.0",
  "description": "Checkbox Node.js SDK: automatic-renewal-law compliance (ROSCA, California ARL, New York and other state laws) for subscription businesses. Zero dependencies. Published to npm as @checkbox-site/node.",
  "keywords": [
    "subscription",
    "auto-renewal",
    "automatic-renewal",
    "compliance",
    "rosca",
    "click-to-cancel",
    "california-arl",
    "stripe",
    "stripe-checkout",
    "checkout",
    "cancellation"
  ],
  "license": "MIT",
  "author": "Checkbox <support@checkbox.site>",
  "homepage": "https://checkbox.site/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkbox-site/checkbox.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/checkbox-site/checkbox/issues",
    "email": "support@checkbox.site"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  }
}
