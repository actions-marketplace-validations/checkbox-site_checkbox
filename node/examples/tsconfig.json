{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@checkbox-site/node": [
        "../src/index.ts"
      ]
    }
  },
  "include": [
    "compliant-checkout.ts",
    "register-site.ts",
    "usage.ts",
    "quickstart.ts",
    "nextjs/app/api/webhooks/checkbox/route.ts"
  ]
}
