{
  "name": "checkbox-repo",
  "private": true,
  "description": "Checkbox SDKs and MCP server (npm workspaces: node, mcp). Not published; see RELEASING.md.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["node", "mcp"],
  "engines": { "node": ">=20" },
